{
  "name": "@jsonblog/generator-boilerplate",
  "version": "5.0.0",
  "description": "A boilerplate generator for JsonBlog",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint ./src",
    "clean": "rm -rf dist .turbo",
    "format": "biome format --write ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsonblog/jsonblog.git",
    "directory": "packages/generator-boilerplate"
  },
  "keywords": [
    "jsonblog",
    "blog",
    "generator",
    "static-site",
    "markdown"
  ],
  "author": "JSON Blog Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsonblog/jsonblog/issues"
  },
  "homepage": "https://github.com/jsonblog/jsonblog/tree/main/packages/generator-boilerplate#readme",
  "dependencies": {
    "@jsonblog/core": "workspace:*",
    "@jsonblog/schema": "workspace:*"
  },
  "devDependencies": {
    "@jsonblog/tsconfig": "workspace:*",
    "@types/chokidar": "^2.1.7",
    "@types/express": "^5.0.3",
    "@types/handlebars": "^4.1.0",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.0.0",
    "@types/rss": "^0.0.32",
    "@types/ws": "^8.18.1",
    "chokidar": "^4.0.3",
    "express": "^4.18.2",
    "ws": "^8.18.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
