{
  "name": "@jsonblog/generator-mono",
  "version": "0.2.0",
  "description": "Warm paper, serif prose, mono UI — a subtle editorial engineering theme for JsonBlog",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dev-server": {
      "import": {
        "types": "./dist/dev-server.d.ts",
        "default": "./dist/dev-server.js"
      },
      "require": {
        "types": "./dist/dev-server.d.cts",
        "default": "./dist/dev-server.cjs"
      }
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint ./src",
    "clean": "rm -rf dist .turbo",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "publint --strict",
    "check:exports": "attw --pack ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsonblog/jsonblog.git",
    "directory": "packages/generator-mono"
  },
  "keywords": [
    "jsonblog",
    "blog",
    "generator",
    "static-site",
    "markdown",
    "monospace",
    "serif",
    "editorial",
    "minimal"
  ],
  "author": "Thomas Davis <thomasalwyndavis@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsonblog/jsonblog/issues"
  },
  "homepage": "https://github.com/jsonblog/jsonblog/tree/main/packages/generator-mono#readme",
  "dependencies": {
    "@jsonblog/core": "workspace:*",
    "@jsonblog/schema": "workspace:*"
  },
  "devDependencies": {
    "@jsonblog/tsconfig": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.0.0",
    "@types/rss": "^0.0.32",
    "@types/ws": "^8.18.1",
    "chokidar": "^4.0.3",
    "express": "^4.18.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "ws": "^8.18.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
