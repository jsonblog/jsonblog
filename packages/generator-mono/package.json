{
  "name": "@jsonblog/generator-mono",
  "version": "0.2.0",
  "description": "Warm paper, serif prose, mono UI — a subtle editorial engineering theme for JsonBlog",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dev-server": {
      "types": "./dist/dev-server.d.ts",
      "import": "./dist/dev-server.js",
      "require": "./dist/dev-server.cjs"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist .turbo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsonblog/jsonblog.git",
    "directory": "packages/generator-mono"
  },
  "keywords": [
    "jsonblog",
    "blog",
    "generator",
    "static-site",
    "markdown",
    "monospace",
    "serif",
    "editorial",
    "minimal"
  ],
  "author": "Thomas Davis <thomasalwyndavis@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsonblog/jsonblog/issues"
  },
  "homepage": "https://github.com/jsonblog/jsonblog/tree/main/packages/generator-mono#readme",
  "dependencies": {
    "@jsonblog/schema": "workspace:*",
    "axios": "^1.6.2",
    "handlebars": "^4.7.8",
    "markdown-it": "^14.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "rss": "^1.2.2",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@jsonblog/tsconfig": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.0.0",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.0.0",
    "@types/rss": "^0.0.32",
    "@types/ws": "^8.18.1",
    "chokidar": "^4.0.3",
    "express": "^4.18.2",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "ws": "^8.18.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
