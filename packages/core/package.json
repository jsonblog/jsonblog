{
  "name": "@jsonblog/core",
  "version": "1.0.0",
  "description": "The shared JsonBlog generator engine — markdown pipeline, pagination, RSS/sitemap, and the `createGenerator` theme contract.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "clean": "rm -rf dist .turbo",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "publint --strict",
    "check:exports": "attw --pack ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsonblog/jsonblog.git",
    "directory": "packages/core"
  },
  "keywords": [
    "jsonblog",
    "blog",
    "generator",
    "static-site",
    "markdown",
    "engine"
  ],
  "author": "JSON Blog Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsonblog/jsonblog/issues"
  },
  "homepage": "https://github.com/jsonblog/jsonblog/tree/main/packages/core#readme",
  "dependencies": {
    "@jsonblog/schema": "workspace:*",
    "axios": "^1.6.2",
    "handlebars": "^4.7.8",
    "markdown-it": "^14.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "rss": "^1.2.2",
    "shiki": "^3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@jsonblog/tsconfig": "workspace:*",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.0.0",
    "@types/rss": "^0.0.32",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
